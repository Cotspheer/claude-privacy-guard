{
  "extraKnownMarketplaces": {
    "claude-privacy-guard": {
      "source": {
        "source": "github",
        "repo": "Cotspheer/claude-privacy-guard"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "privacy-guard@claude-privacy-guard": true
  },
  "appendPlugins": [
    "privacy-guard@claude-privacy-guard"
  ],
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "feedbackSurveyRate": 0,
  "claudeMd": "REPLACE with the text of rules/email-address.md"
}
